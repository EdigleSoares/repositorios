{
  "expo": {
    "name": "PixFala",
    "slug": "pixfala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/PixFalaIcone.png",
    "scheme": "pixfala",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0C1B13",
        "foregroundImage": "./assets/images/PixFalaIcone.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.marcossoares.pixfala"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0F12"
        }
      ],
      "./plugins/withNubankNotificationListener",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a99d761c-9373-40ae-87d2-66306672de63"
      },
      "router": {}
    },
    "owner": "devmarcossoares"
  }
}
